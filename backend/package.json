{
  "name": "@juee/api",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/jobs/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.ts",
    "indexes": "node --env-file-if-exists=.env --import tsx src/jobs/indexes.ts",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "argon2": "^0.44.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "9.11.4",
    "nodemailer": "^10.2.1",
    "otplib": "12.0.1",
    "qrcode-terminal": "^0.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0"
  }
}
