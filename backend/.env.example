NODE_ENV=development
PORT=5000
BIND_HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/juee?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
ADMIN_WEB_ORIGIN=http://127.0.0.1:3002
# Để trống khi dùng cùng địa chỉ với WEB_ORIGIN.
PUBLIC_ORDER_ORIGIN=
# Đặt 1 khi API chỉ nhận lưu lượng qua đúng một proxy tin cậy như Next.js.
TRUST_PROXY_HOPS=0
SMTP_URL=
MAIL_FROM=
# OAuth Web application, chỉ lưu giá trị thật ở backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chỉ dùng cho chạy local với NODE_ENV=development và không có SMTP.
ALLOW_UNVERIFIED_LOCAL_SIGNUP=false
# Tuỳ chọn. Dùng cùng khoá API đã cấu hình ở webhook SePay.
SEPAY_WEBHOOK_API_KEY=
# Tài khoản của JUEE POS dùng để nhận tiền thuê bao qua VietQR.
SAAS_BANK_BIN=
SAAS_BANK_ACCOUNT=
SAAS_BANK_HOLDER=
# Tên ngân hàng đúng trường gateway mà SePay gửi.
SAAS_BANK_GATEWAY=
SAAS_SEPAY_WEBHOOK_API_KEY=
